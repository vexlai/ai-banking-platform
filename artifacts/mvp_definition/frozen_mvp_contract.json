{
  "version": "mvp-contract-v1",
  "decision": "GO WITH CONSTRAINTS",
  "name": "Transaction Dispute Intake & Investigation Copilot",
  "outcome": "HANDOFF_RECORDED",
  "in_scope": [
    "authenticated intake",
    "structured clue extraction",
    "clarification",
    "deterministic transaction lookup",
    "bounded candidate retrieval",
    "explicit transaction confirmation",
    "ownership verification",
    "evidence retrieval",
    "historical context retrieval",
    "grounded summarization",
    "unknown/missing evidence representation",
    "state tracking",
    "human handoff",
    "audit/provenance"
  ],
  "out_of_scope": [
    "autonomous dispute adjudication",
    "automatic reimbursement",
    "money movement",
    "fraud verdict",
    "automated rejection",
    "automatic complaint-to-transaction linking",
    "automatic closure",
    "invented banking policy",
    "unsupported customer identity inference"
  ],
  "responsibilities": [
    {
      "owner": "AI / LLM",
      "allowed": "intent/clue extraction; clarification drafting; evidence-grounded summary; unresolved questions; handoff draft",
      "forbidden": "auth/authz; ownership; resolving ambiguity as truth; policy invention; fraud verdict; approval/rejection; financial action; closure"
    },
    {
      "owner": "DETERMINISTIC",
      "allowed": "external auth validation; authorization/account access; retrieval/filtering; temporal cutoff; currency/units; ownership; state guards; policy interface; audit; idempotency",
      "forbidden": "inventing policy, treating heuristic candidate as true match, claiming dataset identity equals authentication"
    },
    {
      "owner": "HUMAN",
      "allowed": "unresolved ambiguity; conflicts; authoritative policy interpretation; adjudication; financial decisions; final outcome; closure",
      "forbidden": "bypassing authentication/authorization or leaving approvals unaudited"
    }
  ],
  "data_contracts": [
    {
      "contract": "AuthenticatedPrincipal",
      "required_fields": [
        "principal_ref",
        "subject_ref",
        "authorization_scope",
        "verified_at",
        "expires_at",
        "auth_provider_ref"
      ],
      "optional_fields": [
        "session_ref"
      ],
      "provenance": "External identity provider; never utterance/LLM",
      "as_of_time_rule": "verified_at <= as_of_time < expires_at",
      "trust_level": "trusted only after external deterministic validation",
      "LLM_values_require_confirmation": false
    },
    {
      "contract": "DisputeIntake",
      "required_fields": [
        "case_id",
        "user_utterance",
        "language",
        "principal_ref",
        "as_of_time",
        "request_id"
      ],
      "optional_fields": [
        "customer_confirmed_clues"
      ],
      "provenance": "Untrusted customer request; exact text retained with access controls",
      "as_of_time_rule": "server-assigned case.as_of_time",
      "trust_level": "untrusted input",
      "LLM_values_require_confirmation": true
    },
    {
      "contract": "TransactionSearchRequest",
      "required_fields": [
        "case_id",
        "principal_ref",
        "as_of_time",
        "rule_version",
        "lookback_days"
      ],
      "optional_fields": [
        "transaction_id",
        "amount",
        "currency",
        "date_hint",
        "merchant",
        "transaction_type_hint",
        "channel_hint"
      ],
      "provenance": "Confirmed clues and trusted principal separately; no currency/date guessing",
      "as_of_time_rule": "bounded event_time <= as_of_time; explicit start/end inclusivity",
      "trust_level": "validated request, not fact",
      "LLM_values_require_confirmation": true
    },
    {
      "contract": "TransactionCandidate",
      "required_fields": [
        "candidate_transaction_id",
        "owner_ref",
        "product_ref",
        "event_time",
        "amount",
        "currency",
        "source_ref",
        "retrieval_rule"
      ],
      "optional_fields": [
        "merchant",
        "recorded_status",
        "channel",
        "type"
      ],
      "provenance": "Deterministic query result; relation to complaint is HEURISTIC",
      "as_of_time_rule": "event_time <= as_of_time; availability warning mandatory",
      "trust_level": "observed transaction, unverified dispute link",
      "LLM_values_require_confirmation": false
    },
    {
      "contract": "TransactionSelection",
      "required_fields": [
        "case_id",
        "candidate_transaction_id",
        "confirmed_by",
        "confirmed_at",
        "confirmation_ref"
      ],
      "optional_fields": [
        "clarification_history"
      ],
      "provenance": "Explicit customer/authorized-human confirmation; never count=1 alone",
      "as_of_time_rule": "confirmation timestamp audited",
      "trust_level": "attributed selection, not fraud verdict",
      "LLM_values_require_confirmation": true
    },
    {
      "contract": "EvidenceBundle",
      "required_fields": [
        "case_id",
        "as_of_time",
        "source_refs",
        "core_facts",
        "unknowns",
        "guard_results",
        "availability_limitations"
      ],
      "optional_fields": [
        "optional_context",
        "retrospective_context"
      ],
      "provenance": "Allowlisted source evidence, independently aggregated domains",
      "as_of_time_rule": "admissible and retrospective evidence separate; snapshot attributes flagged",
      "trust_level": "mixed trust with field provenance",
      "LLM_values_require_confirmation": false
    },
    {
      "contract": "GroundedSummary",
      "required_fields": [
        "case_id",
        "facts_with_evidence_refs",
        "unknowns",
        "unresolved_questions",
        "generator_version"
      ],
      "optional_fields": [
        "draft_narrative"
      ],
      "provenance": "LLM-generated draft; deterministic references + human factual review",
      "as_of_time_rule": "only intake-admissible evidence may be asserted as intake facts",
      "trust_level": "untrusted generated content",
      "LLM_values_require_confirmation": true
    },
    {
      "contract": "HandoffPackage",
      "required_fields": [
        "case_id",
        "user_request",
        "authenticated_identity_reference",
        "selected_transaction_or_candidates",
        "verified_facts",
        "evidence_references",
        "actions_taken",
        "missing_evidence",
        "unresolved_questions",
        "guard_results",
        "state",
        "as_of_time"
      ],
      "optional_fields": [
        "draft_summary",
        "handoff_receipt"
      ],
      "provenance": "Deterministic assembly; optional generated draft; authorized recipient",
      "as_of_time_rule": "evidence snapshot/as_of plus handoff time distinct",
      "trust_level": "auditable package, not adjudication",
      "LLM_values_require_confirmation": true
    },
    {
      "contract": "CaseState",
      "required_fields": [
        "case_id",
        "state",
        "version",
        "updated_at",
        "last_transition_id"
      ],
      "optional_fields": [
        "failure_reason"
      ],
      "provenance": "Deterministic guarded state store; FUTURE DESIGN",
      "as_of_time_rule": "versioned event/recorded timestamps",
      "trust_level": "trusted only after guards; no engine implemented",
      "LLM_values_require_confirmation": false
    },
    {
      "contract": "AuditEvent",
      "required_fields": [
        "event_id",
        "case_id",
        "request_id",
        "idempotency_key",
        "actor_ref",
        "source_state",
        "target_state",
        "event_time",
        "recorded_at",
        "evidence_refs",
        "guard_results",
        "rule_version"
      ],
      "optional_fields": [
        "policy_version",
        "model_version",
        "approval_ref"
      ],
      "provenance": "Append-only future service audit; immutable evidence versions",
      "as_of_time_rule": "event_time and recorded_at separately",
      "trust_level": "system-generated; LLM cannot author authority",
      "LLM_values_require_confirmation": false
    }
  ],
  "success_criteria": [
    {
      "criterion": "extraction correctness",
      "measurement": "per-field EM/P/R/F1 and full-schema EM, dev/test and es/pt separately",
      "target": "Report baseline; future improvement on frozen test without degrading safety"
    },
    {
      "criterion": "schema validity",
      "measurement": "valid schemas / outputs",
      "target": "100% proposed acceptance gate"
    },
    {
      "criterion": "hallucination",
      "measurement": "unsupported nonnull fields / expected-unknown slots and / predicted slots",
      "target": "0 desired; observed baseline failures retained"
    },
    {
      "criterion": "clarification and missing clues",
      "measurement": "should_clarify accuracy; exact missing required clue set",
      "target": "Baseline first; human-reviewed annotations needed"
    },
    {
      "criterion": "retrieval invariants",
      "measurement": "exact candidate set; missing/extra; future/ownership/auth exposure",
      "target": "100% fixture correctness; zero safety violations"
    },
    {
      "criterion": "abstention",
      "measurement": "correct deny/clarify/abstain/handoff on contract fixtures",
      "target": "No autonomous decision; safety scenarios mandatory"
    },
    {
      "criterion": "handoff quality",
      "measurement": "completeness; unsupported structured claims; valid evidence refs",
      "target": "All required sections; no unsupported facts"
    },
    {
      "criterion": "state/audit validity",
      "measurement": "valid guarded transitions and audit fields",
      "target": "Future runtime only; NOT MEASURED here"
    },
    {
      "criterion": "unsafe actions / authorization violations",
      "measurement": "forbidden actions or access violations / attempted requests",
      "target": "Zero required; fixture checks are not production certification"
    },
    {
      "criterion": "latency/cost",
      "measurement": "per-case parser latency; future end-to-end/model cost",
      "target": "Report measured parser only; no invented production savings"
    }
  ],
