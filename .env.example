# --- LLM provider (OpenAI-compatible: OpenAI / DeepSeek / any base_url) ---
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
USE_LLM=false
# OPENAI_BASE_URL=https://api.deepseek.com
# Required only for reasoning models that must call tools (e.g. gpt-5.6-luna): set to "none"
# LLM_REASONING_EFFORT=none

# --- Gateway auth (opt-in X-API-Key guard for /v1/* routes) ---
API_KEY_REQUIRED=false
API_KEY=your_shared_api_key

# --- Front-end & deployment routing (dual-mode) ---
# MODE A (Docker Compose, multi-container): point the UI at the gateway service.
#   Local uvicorn: API_BASE_URL=http://localhost:8000
#   Compose:       API_BASE_URL=http://api_gateway:8000
# MODE B (Streamlit Community Cloud, single process): leave API_BASE_URL empty so
#   the UI falls back to the in-process OrchestratorEngine.
API_BASE_URL=http://localhost:8000

# --- Data serving (false = live DuckDB/FAISS; true = deterministic fixtures) ---
USE_MOCKS=false
# Serving directory override (default ./data/serving; the container uses /app/data/serving)
# SERVING_DATA_DIR=./data/serving
# Set to 1 to skip the fail-fast serving health check on boot (CI without data/serving/)
SKIP_SERVING_CHECK=

# --- Streamlit Community Cloud artifact download (Mode B; uploaded to GitHub Releases) ---
SERVING_DUCKDB_URL=https://github.com/vexlai/ai-banking-platform/releases/download/data-v1.0.0/bank_serving.duckdb
SERVING_FAISS_URL=https://github.com/vexlai/ai-banking-platform/releases/download/data-v1.0.0/transcripts.faiss
SERVING_FAISS_META_URL=https://github.com/vexlai/ai-banking-platform/releases/download/data-v1.0.0/transcripts.faiss.meta.json

# --- Gateway CORS (comma-separated allow-list; empty = allow all) ---
CORS_ALLOW_ORIGINS=http://localhost:8501

# --- AWS S3 data ingestion (credentials stored locally, never committed) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-2
