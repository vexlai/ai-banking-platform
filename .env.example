# --- LLM provider (OpenAI-compatible: OpenAI / DeepSeek / any base_url) ---
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
USE_LLM=false
# OPENAI_BASE_URL=https://api.deepseek.com
# Required only for reasoning models that must call tools (e.g. gpt-5.6-luna): set to "none"
# LLM_REASONING_EFFORT=none

# --- Gateway auth (opt-in X-API-Key guard for /v1/* routes) ---
API_KEY_REQUIRED=false
API_KEY=your_shared_api_key

# --- Front-end ---
API_BASE_URL=http://localhost:8000

# --- Data serving (false = live DuckDB/FAISS; true = deterministic fixtures) ---
USE_MOCKS=false
# Serving directory override (default ./data/serving; the container uses /app/data/serving)
# SERVING_DATA_DIR=./data/serving
# Set to 1 to skip the fail-fast serving health check on boot (CI without data/serving/)
SKIP_SERVING_CHECK=

# --- Gateway CORS (comma-separated allow-list; empty = allow all) ---
CORS_ALLOW_ORIGINS=http://localhost:8501
